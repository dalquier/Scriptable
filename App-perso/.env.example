# Secret value: configure only in Replit Secrets or the approved secret manager.
OPENAI_API_KEY=

# Central model routing. Set current model IDs in the runtime environment.
OPENAI_MODEL_ECONOMY=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_REASONING=
OPENAI_MODEL_CODING=
OPENAI_MODEL_EMBEDDING=

OPENAI_WEB_ENABLED=true
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
