# Secret value: configure only in Replit Secrets or the approved secret manager.
OPENAI_API_KEY=

# Central model routing defaults. Override only after representative evaluations.
OPENAI_MODEL_ECONOMY=gpt-5.6-luna
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_REASONING=gpt-5.6-sol
OPENAI_MODEL_CODING=gpt-5.6-sol
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

OPENAI_REASONING_ECONOMY=none
OPENAI_REASONING_BALANCED=low
OPENAI_REASONING_REASONING=medium
OPENAI_REASONING_CODING=high

OPENAI_WEB_ENABLED=true
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
